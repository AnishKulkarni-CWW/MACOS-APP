{
  "name": "bmw-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"npm run electron:start\"",
    "electron:start": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build": "tsc -b && vite build",
    "build:electron": "npm run build && electron-builder",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/pako": "^2.0.4",
    "ag-psd": "^31.0.2",
    "jszip": "^3.10.1",
    "pako": "^3.0.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wait-on": "^9.1.0"
  },
  "description": "Enterprise automated asset localization, Illustrator syndication, and deep quality assurance desktop application for BMW campaigns.",
  "author": "Craft Worldwide / IPG",
  "build": {
    "appId": "com.bmw.automation",
    "productName": "BMW Auto",
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "public/icon.icns",
      "target": [
        "dmg"
      ]
    },
    "extraResources": [
      {
        "from": "electron/ocr-vision",
        "to": "electron/ocr-vision"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*"
    ]
  }
}
